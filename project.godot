; Engine configuration file.
; Godot 4.5 .NET

config_version=5

[application]

config/name="My Autumn Car"
config/description="Part-by-part car assembly and survival sim. Vertical slice."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")

[dotnet]

project/assembly_name="MyAutumnCar"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=9.8
3d/solver/solver_iterations=16

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
anti_aliasing/quality/msaa_3d=2
